{
  "name": "cretueusebiu/laravel-vue-spa",
  "description": "A Laravel-Vue SPA starter project template.",
  "keywords": [
    "spa",
    "laravel",
    "vue"
  ],
  "license": "MIT",
  "type": "project",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/IMSGlobal/lti-1-3-php-library"
    },
    {
      "type": "composer",
      "url": "https://www.setasign.com/downloads/"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "centrifugal/phpcent": "~5.0",
    "fakerphp/faker": "^1.23",
    "google/auth": "^1.26",
    "guzzlehttp/guzzle": "^7.8",
    "irazasyed/telegram-bot-sdk": "^3.4",
    "laravel/framework": "^12.0",
    "laravel/socialite": "^5.16",
    "laravel/tinker": "^2.10",
    "laravel/ui": "^4.6",
    "laravel/vapor-cli": "^1.60",
    "laravel/vapor-core": "^2.37",
    "league/flysystem": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "miladrahimi/php-jwt": "3.*",
    "orhanerday/open-ai": "^5.2",
    "predis/predis": "^2.0",
    "pusher/pusher-php-server": "^7.2",
    "setasign/fpdf": "1.8.*",
    "setasign/fpdi": "^2.6",
    "setasign/fpdi_pdf-parser": "^2.0",
    "snowfire/beautymail": "^1.1",
    "spipu/html2pdf": "^5.2",
    "spomky-labs/aes-key-wrap": "^7.0",
    "symfony/http-client": "^7.4",
    "symfony/mailgun-mailer": "^8.1",
    "tymon/jwt-auth": "^2.2",
    "web-token/jwt-library": "^3.4"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.14",
    "brianium/paratest": "^7.8",
    "laravel/dusk": "^8.2",
    "laravel/legacy-factories": "^1.4",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5",
    "rector/rector": "^2.7",
    "spatie/laravel-ignition": "^2.9"
  },
  "config": {
    "platform": {
      "php": "8.4.17"
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/dusk"
      ]
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Overrides\\IMSGlobal\\LTI\\": "app/Overrides/imsglobal/lti",
      "Overrides\\IMSGlobal\\LTI\\MessageValidators\\": "app/Overrides/imsglobal/lti/message_validators"
    },
    "classmap": [
      "database/seeds",
      "app/Custom"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php artisan jwt:secret --force --ansi"
    ]
  }
}
